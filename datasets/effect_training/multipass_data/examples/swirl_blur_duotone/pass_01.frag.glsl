precision highp float; varying vec2 textureCoord; uniform sampler2D inputImageTexture; uniform float uProgress; uniform float uTime; void main(){vec2 uv=textureCoord;vec2 q=uv-.5;float a=.8*uProgress*exp(-length(q)*2.);uv=mat2(cos(a),-sin(a),sin(a),cos(a))*q+.5;gl_FragColor=texture2D(inputImageTexture,uv);}
