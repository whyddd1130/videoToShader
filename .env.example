# Copy to env.sh or export these variables in your shell. Never commit real keys.
export WQ_API_KEY="YOUR_API_KEY"
export EFFECT_IR_LLM_API_KEY="$WQ_API_KEY"

export EFFECT_IR_LLM_MODEL="YOUR_MULTIMODAL_MODEL_ENDPOINT"
export EFFECT_IR_CODE_LLM_MODEL="YOUR_CODE_MODEL_ENDPOINT"
export EFFECT_IR_LLM_ENDPOINT="https://wanqing-api.corp.kuaishou.com/api/gateway/v1/endpoints/chat/completions"
export EFFECT_IR_CODE_LLM_ENDPOINT="$EFFECT_IR_LLM_ENDPOINT"
export EFFECT_IR_LLM_PROVIDER="http_json"
export EFFECT_IR_LLM_CONTENT_MODE="parts"
export EFFECT_IR_LLM_TIMEOUT="300"
export EFFECT_IR_LLM_RETRIES="3"

# Optional remote single-pass Shader Lab.
export SHADER_LAB_URL="http://YOUR_SHADER_LAB_HOST"
export SHADER_LAB_TOKEN="YOUR_SHADER_LAB_TOKEN"

# Multi-pass rendering defaults to the bundled local ModernGL renderer.
export MULTIPASS_RENDER_BACKEND="local"
